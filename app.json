{
  "expo": {
    "name": "ApnaCircle",
    "slug": "apnacircle",
    "scheme": "apnacircle",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.kailramiya.apnacircle" },
    "android": {
      "package": "com.kailramiya.apnacircle",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-localization",
      ["expo-image-picker", {
        "photosPermission": "Allow ApnaCircle to use a photo you choose for your post or profile.",
        "cameraPermission": false,
        "microphonePermission": false
      }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
